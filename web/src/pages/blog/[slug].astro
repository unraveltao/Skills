---
import Base from '../../layouts/Base.astro';
import { blogSeries, getBlogPost, posts } from '../../lib/blog';
import { sections, readDoc } from '../../lib/docs';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { slug: post.slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const post = getBlogPost(slug, base)!;
const seriesPosts = posts.filter((entry) => entry.seriesId === post.seriesId).sort((a, b) => a.order - b.order);
const previous = seriesPosts.find((entry) => entry.order === post.order - 1);
const next = seriesPosts.find((entry) => entry.order === post.order + 1);
const docsHref = (entry: { slug: string }) => entry.slug === 'introduction' ? base + '/docs/' : base + '/docs/' + entry.slug + '/';
const blogSearchEntries = posts.map((entry) => ({
  ...entry,
  seriesCount: posts.filter((candidate) => candidate.seriesId === entry.seriesId).length,
  text: (getBlogPost(entry.slug, base)?.html ?? '').replace(/<[^>]+>/g, ' '),
}));
const tocItems = [...post.html.matchAll(/<h([2-3]) id="([^"]+)">([\s\S]*?)<\/h\1>/g)].map((match) => ({
  level: Number(match[1]),
  id: match[2],
  title: match[3].replace(/<[^>]+>/g, '').trim(),
}));
const completedProgress = seriesPosts.length > 1 ? ((post.order - 1) / (seriesPosts.length - 1)) * 100 : 0;
---

<Base title={`${post.title} — Unravel Skills`}>
  <div class="blog-layout container">
    <aside class="series-sidebar" aria-label={post.seriesTitle + ' navigation'}>
      <button class="docs-search-trigger blog-search-trigger" type="button" data-open-doc-search aria-haspopup="dialog" aria-controls="blog-search-dialog">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
        <span>Search Docs</span>
      </button>
      {blogSeries.map((series) => (
        <details class="series-group" open>
          <summary class="series-summary">
            <svg class="series-folder-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.2 7.4a1.8 1.8 0 0 1 1.8-1.8h5l2 2h7a1.8 1.8 0 0 1 1.8 1.8v8.2a1.8 1.8 0 0 1-1.8 1.8H5a1.8 1.8 0 0 1-1.8-1.8z"></path>
              <path d="M7 11.6h7M7 14.6h9"></path>
            </svg>
            <span class="series-summary-title">{series.title}</span>
            <span class="series-summary-count">{String(series.posts.length).padStart(2, '0')}</span>
            <svg class="series-folder-chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m3.5 6 4.5 4.5L12.5 6"></path></svg>
          </summary>
          <p class="series-sidebar-description">{series.description}</p>
          <nav class="series-article-list" aria-label={series.title + ' articles'}>
            {series.posts.map((step) => {
              const isCurrentSeries = series.id === post.seriesId;
              const isCurrentArticle = isCurrentSeries && step.order === post.order;
              const isComplete = isCurrentSeries && step.order < post.order;
              return (
                <a
                  class:list={['series-article-link', isComplete && 'is-complete', isCurrentArticle && 'is-current']}
                  href={base + '/blog/' + step.slug + '/'}
                  aria-current={isCurrentArticle ? 'page' : undefined}
                  aria-label={'Part ' + step.order + ' of ' + series.posts.length + ': ' + step.title + (isComplete ? ' (completed)' : isCurrentArticle ? ' (current article)' : '')}
                >
                  <span class="series-article-index" aria-hidden="true">{isComplete ? '✓' : String(step.order).padStart(2, '0')}</span>
                  <span class="series-article-title">{step.title}</span>
                </a>
              );
            })}
          </nav>
        </details>
      ))}
    </aside>

    <main class="blog-main">
      <div class="breadcrumb"><a href={`${base}/blog/`}>Blog</a><span aria-hidden="true">/</span><span>{post.seriesTitle}</span></div>
      <span class="eyebrow small">FROM THE WORKBENCH · {post.seriesTitle}</span>
      <h1>{post.title}</h1>
      <p class="article-lead">{post.summary}</p>
      <details class="mobile-article-toc">
        <summary>In this article</summary>
        <nav class="toc-links" aria-label="Article sections">
          {tocItems.map((item) => (
            <a class:list={['toc-link', item.level === 3 && 'toc-link-nested']} href={'#' + item.id}>
              <span class="toc-link-marker" aria-hidden="true"></span>
              <span>{item.title}</span>
            </a>
          ))}
        </nav>
      </details>

      <section class="series-progress" aria-label={`Part ${post.order} of ${seriesPosts.length} in the ${post.seriesTitle}`}>
        <div class="series-progress-heading">
          <div>
            <span class="eyebrow small">{post.seriesTitle.toUpperCase()}</span>
            <p>{post.seriesDescription}</p>
          </div>
          <span class="series-count"><strong>{String(post.order).padStart(2, '0')}</strong><span>/ {String(seriesPosts.length).padStart(2, '0')}</span></span>
        </div>
        <ol class="series-steps" style={`--series-progress: ${completedProgress}%; --series-count: ${seriesPosts.length}`}>
          {seriesPosts.map((step) => (
            <li class:list={['series-step', step.order < post.order && 'is-complete', step.order === post.order && 'is-current']}>
              <a
                class="series-step-link"
                href={`${base}/blog/${step.slug}/`}
                aria-current={step.order === post.order ? 'step' : undefined}
                aria-label={`Part ${step.order} of ${seriesPosts.length}: ${step.title}${step.order === post.order ? ' (current article)' : ''}`}
                title={step.title}
              >
                <span class="series-node" aria-hidden="true">{step.order < post.order ? '✓' : String(step.order).padStart(2, '0')}</span>
                <span class="series-step-label">Part {step.order}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <article class="prose" set:html={post.html} />

      <nav class="series-nav" aria-label={post.seriesTitle + ' article navigation'}>
        {previous ? (
          <a class="series-nav-item previous" href={`${base}/blog/${previous.slug}/`}>
            <span class="eyebrow small">← PREVIOUS ARTICLE</span>
            <strong>{previous.title}</strong>
          </a>
        ) : <span class="series-nav-spacer"></span>}
        {next ? (
          <a class="series-nav-item next" href={`${base}/blog/${next.slug}/`}>
            <span class="eyebrow small">NEXT ARTICLE →</span>
            <strong>{next.title}</strong>
          </a>
        ) : <span class="series-nav-spacer"></span>}
      </nav>
    </main>
    <aside class="article-toc" aria-label="Article contents">
      <span class="eyebrow small">ON THIS PAGE</span>
      <nav class="toc-links" aria-label="Article sections">
        {tocItems.map((item) => (
          <a
            class:list={['toc-link', item.level === 3 && 'toc-link-nested']}
            href={`#${item.id}`}
          >
            {item.title}
          </a>
        ))}
      </nav>
    </aside>
  </div>
  <dialog id="blog-search-dialog" class="docs-search-dialog" aria-labelledby="blog-search-title">
    <div class="docs-search-heading">
      <h2 id="blog-search-title">Search Docs and Blog</h2>
      <button class="docs-search-close" type="button" data-close-doc-search aria-label="Close search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
      </button>
    </div>
    <label class="docs-search-input-wrap">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg>
      <input id="blog-search-input" type="search" placeholder="What are you searching for?" autocomplete="off" />
    </label>
    <div class="docs-search-results">
      <p class="docs-search-results-label" id="blog-search-results-label">Suggestions</p>
      <nav aria-label="Docs and Blog search results" id="blog-search-results">
        {sections.flatMap((section) => section.pages.map((entry) => (
          <a class="docs-search-result" data-blog-search-result data-search={section.title + ' ' + entry.title + ' ' + readDoc(entry)} href={docsHref(entry)}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.8h8l4 4v12.4H6z"></path><path d="M14 3.8v4h4M9 12h6M9 15.5h6"></path></svg>
            <span><small class="docs-search-type">DOCS</small><strong>{entry.title}</strong><small>{section.title}</small></span>
          </a>
        )))}
        {blogSearchEntries.map((entry) => (
          <a class="docs-search-result" data-blog-search-result data-search={entry.title + ' ' + entry.summary + ' ' + entry.text} href={base + '/blog/' + entry.slug + '/'}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.8h8l4 4v12.4H6z"></path><path d="M14 3.8v4h4M9 12h6M9 15.5h6"></path></svg>
            <span><small class="docs-search-type">BLOG</small><strong>{entry.title}</strong><small>{entry.seriesTitle} · Part {String(entry.order).padStart(2, '0')} of {String(entry.seriesCount).padStart(2, '0')}</small></span>
          </a>
        ))}
      </nav>
      <p class="docs-search-empty" id="blog-search-empty" hidden>No matching docs or articles. Try another search.</p>
    </div>
  </dialog>
</Base>

<script>
  const blogSearchDialog = document.querySelector<HTMLDialogElement>('#blog-search-dialog');
  const blogSearchInput = document.querySelector<HTMLInputElement>('#blog-search-input');
  const blogSearchItems = [...document.querySelectorAll<HTMLAnchorElement>('[data-blog-search-result]')];
  const blogSearchLabel = document.querySelector<HTMLElement>('#blog-search-results-label');
  const blogSearchEmpty = document.querySelector<HTMLElement>('#blog-search-empty');

  const filterBlogSearch = () => {
    const query = blogSearchInput?.value.trim().toLocaleLowerCase() ?? '';
    let visibleCount = 0;
    blogSearchItems.forEach((item) => {
      const matches = !query || (item.dataset.search ?? item.textContent ?? '').toLocaleLowerCase().includes(query);
      item.hidden = !matches;
      if (matches) visibleCount += 1;
    });
    if (blogSearchLabel) blogSearchLabel.textContent = query ? 'Results' : 'Suggestions';
    if (blogSearchEmpty) blogSearchEmpty.hidden = visibleCount > 0;
  };

  const openBlogSearch = () => {
    if (!blogSearchDialog || !blogSearchInput) return;
    blogSearchInput.value = '';
    filterBlogSearch();
    blogSearchDialog.showModal();
    blogSearchInput.focus();
  };

  document.querySelectorAll<HTMLButtonElement>('[data-open-doc-search]').forEach((button) => button.addEventListener('click', openBlogSearch));
  document.querySelector<HTMLButtonElement>('[data-close-doc-search]')?.addEventListener('click', () => blogSearchDialog?.close());
  blogSearchInput?.addEventListener('input', filterBlogSearch);
  blogSearchDialog?.addEventListener('click', (event) => {
    if (event.target === blogSearchDialog) blogSearchDialog.close();
  });
</script>

<script>
  document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
    const code = pre.querySelector('code');
    if (!code) return;

    const languageToken = [...code.classList]
      .find((className) => className.startsWith('language-'))
      ?.replace('language-', '')
      .toLowerCase() ?? 'text';
    const languageNames: Record<string, string> = {
      bash: 'Shell',
      css: 'CSS',
      html: 'HTML',
      js: 'JavaScript',
      json: 'JSON',
      md: 'Markdown',
      py: 'Python',
      python: 'Python',
      sh: 'Shell',
      text: 'Text',
      ts: 'TypeScript',
      tsx: 'TSX',
      jsx: 'JSX',
      yaml: 'YAML',
      yml: 'YAML',
    };
    const language = languageNames[languageToken] ?? languageToken.charAt(0).toUpperCase() + languageToken.slice(1);

    const toolbar = document.createElement('div');
    toolbar.className = 'code-toolbar';

    const label = document.createElement('span');
    label.textContent = language;
    label.className = 'code-language';

    const copy = document.createElement('button');
    copy.type = 'button';
    copy.className = 'code-copy';
    copy.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path></svg>';
    copy.setAttribute('aria-label', 'Copy code sample');
    copy.title = 'Copy code';

    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.innerText);
        copy.classList.add('is-copied');
        copy.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg>';
        copy.setAttribute('aria-label', 'Code copied');
        copy.title = 'Copied';
      } catch {
        copy.classList.add('is-error');
        copy.setAttribute('aria-label', 'Copy failed. Select the code and copy it manually.');
        copy.title = 'Copy failed';
      }
      window.setTimeout(() => {
        copy.classList.remove('is-copied', 'is-error');
        copy.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"></rect><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path></svg>';
        copy.setAttribute('aria-label', 'Copy code sample');
        copy.title = 'Copy code';
      }, 1600);
    });

    toolbar.append(label, copy);
    const frame = document.createElement('div');
    frame.className = 'code-block';
    pre.before(frame);
    frame.append(toolbar, pre);
  });

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link[href^="#"]')];
  const headings = [...new Map(tocLinks
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((heading): heading is HTMLElement => heading instanceof HTMLElement)
    .map((heading) => [heading.id, heading] as const)).values()];

  const setActiveHeading = () => {
    if (!headings.length) return;

    const atPageBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    const readingLine = window.innerHeight * 0.36;
    const currentHeading = atPageBottom
      ? headings[headings.length - 1]
      : [...headings].reverse().find((heading) => heading.getBoundingClientRect().top <= readingLine) ?? headings[0];

    tocLinks.forEach((link) => {
      if (link.hash === `#${currentHeading.id}`) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  let tocUpdateScheduled = false;
  const scheduleTocUpdate = () => {
    if (tocUpdateScheduled) return;
    tocUpdateScheduled = true;
    window.requestAnimationFrame(() => {
      tocUpdateScheduled = false;
      setActiveHeading();
    });
  };

  window.addEventListener('scroll', scheduleTocUpdate, { passive: true });
  window.addEventListener('resize', scheduleTocUpdate);
  window.addEventListener('hashchange', scheduleTocUpdate);
  setActiveHeading();
</script>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 780px);
    justify-content: center;
    align-items: start;
    gap: 48px;
    padding-top: 48px;
    padding-bottom: 80px;
  }

  .article-toc {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: calc(100vh - var(--nav-h) - 48px);
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .article-toc .toc-links {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0;
  }

  .article-toc .toc-link {
    display: block;
    padding: 7px 9px;
    border-radius: 7px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
    text-decoration: none;
  }

  .article-toc .toc-link:hover,
  .article-toc .toc-link[aria-current="location"] {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .article-toc .toc-link[aria-current="location"] {
    font-weight: 650;
  }

  .article-toc .toc-link-nested {
    padding-left: 22px;
  }

  .toc-panel {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    overflow: hidden;
  }

  .toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px;
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-heading {
    display: grid;
    gap: 5px;
  }

  .toc-kicker {
    color: var(--dim);
    font-size: 9px;
    font-weight: 750;
    letter-spacing: .13em;
  }

  .toc-title {
    color: var(--fg);
    font-size: 14px;
    font-weight: 700;
  }

  .toc-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    font-size: 11px;
  }

  .toc-toggle-closed,
  .toc-panel:not([open]) .toc-toggle-open {
    display: none;
  }

  .toc-panel:not([open]) .toc-toggle-closed {
    display: inline;
  }

  .toc-chevron {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--fg);
    font-size: 16px;
    line-height: 1;
    transform: rotate(180deg);
    transition: transform .18s ease;
  }

  .toc-panel:not([open]) .toc-chevron {
    transform: rotate(0);
  }

  .toc-links {
    display: grid;
    gap: 4px;
    padding: 0 10px 12px;
  }

  .toc-link {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 8px 9px;
    border-radius: 7px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.45;
    text-decoration: none;
    transition: background .15s ease, color .15s ease;
  }

  .toc-link:hover,
  .toc-link[aria-current="location"] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .toc-link[aria-current="location"] {
    font-weight: 650;
  }

  .toc-link-marker {
    flex: 0 0 5px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--dim);
  }

  .toc-link[aria-current="location"] .toc-link-marker {
    background: var(--accent);
    box-shadow: 0 0 9px var(--accent);
  }

  .toc-link-nested {
    padding-left: 23px;
    font-size: 11px;
  }

  .blog-main {
    min-width: 0;
  }

  .blog-main > .eyebrow {
    margin-top: 10px;
  }

  .blog-main h1 {
    margin: 14px 0 14px;
    color: var(--fg);
    font-size: clamp(36px, 4vw, 54px);
    letter-spacing: -.045em;
    line-height: 1.1;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 26px;
  }

  .article-lead {
    max-width: 68ch;
    margin-bottom: 26px;
    font-size: 17px;
    line-height: 1.7;
  }

  .series-progress {
    margin: 30px 0 38px;
    padding: 18px 20px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: linear-gradient(115deg, var(--surface), var(--surface-2));
  }

  .series-progress-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .series-progress-heading p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 12px;
  }

  .series-count {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .series-count strong {
    color: var(--fg);
    font-size: 23px;
    letter-spacing: -.04em;
  }

  .series-count span {
    font-size: 11px;
  }

  .series-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--series-count, 6), minmax(0, 1fr));
    margin: 16px 0 0;
    padding: 0 8px;
    list-style: none;
  }

  .series-step:not(:last-child)::after {
    position: absolute;
    z-index: 0;
    top: 14px;
    left: 50%;
    width: 100%;
    height: 2px;
    background: var(--border);
    content: '';
    pointer-events: none;
  }

  .series-step.is-complete::after {
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent-border);
  }

  .series-step {
    position: relative;
    z-index: 1;
    min-width: 0;
    text-align: center;
  }

  .series-step-link {
    position: relative;
    z-index: 1;
    display: inline-grid;
    justify-items: center;
    gap: 6px;
    min-width: 44px;
    color: var(--dim);
    text-decoration: none;
  }

  .series-node {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--dim);
    border-radius: 50%;
    background: var(--surface);
    color: var(--muted);
    font-size: 9px;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    transition: border-color .18s ease, background .18s ease, color .18s ease, box-shadow .18s ease;
  }

  .series-step.is-complete .series-node {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }

  .series-step.is-current .series-node {
    border: 2px solid var(--accent);
    background: var(--surface);
    color: var(--fg);
    box-shadow: 0 0 0 4px var(--accent-soft), 0 0 17px var(--accent);
  }

  .series-step-link:hover .series-node {
    border-color: var(--accent);
  }

  .series-step-label {
    color: var(--dim);
    font-size: 9px;
    line-height: 1.2;
    white-space: nowrap;
  }

  .series-step.is-current .series-step-label {
    color: var(--accent);
    font-weight: 750;
  }

  .prose {
    max-width: 72ch;
    color: var(--fg);
    font-size: 16px;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .prose h1,
  .prose h2,
  .prose h3 {
    color: var(--fg);
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  .prose h2 {
    margin-top: 2.5em;
    margin-bottom: .65em;
    font-size: 25px;
    line-height: 1.28;
    letter-spacing: -.03em;
  }

  .prose h3 {
    margin-top: 1.9em;
    margin-bottom: .5em;
    font-size: 19px;
    line-height: 1.35;
    letter-spacing: -.02em;
  }

  .prose p,
  .prose ul,
  .prose ol {
    color: var(--muted);
    margin-bottom: 1.1em;
  }

  .prose li {
    padding: .2em 0;
  }

