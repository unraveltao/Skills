---
import Base from '../layouts/Base.astro';
import SkillCard from '../components/SkillCard.astro';
import { skills, installCommand, categoryNames } from '../lib/catalog';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = Object.entries(categoryNames);
---
<Base title="Unravel Skills — Skills for AI Agents">
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="eyebrow"><span class="eyebrow-dot"></span> OPEN SOURCE AGENT SKILLS</span>
      <h1>Skills for <span class="gradient-text">AI Agents.</span></h1>
      <p class="hero-lead">Discover, understand and install reusable Agent Skills. Designed for builders, thinkers and curious minds.</p>
      <div class="install-box">
        <div class="install-label"><span>⌘</span> Quick install <span class="install-note">Candidate · verify before use</span></div>
        <div class="command-line"><code>{installCommand}</code><button class="copy-button" data-copy={installCommand} aria-label="Copy installation command">Copy</button></div>
      </div>
      <div class="hero-actions"><a class="button primary" href="#explore">Explore Skills ↓</a><a class="button secondary" href={`${base}/docs/`}>View Docs ↗</a></div>
    </div>
  </section>
  <section class="catalog container" id="explore">
    <div class="section-head"><div><span class="eyebrow small">THE COLLECTION</span><h2>Explore Skills<span class="accent-dot">.</span></h2><p>Focused capabilities, one Skill at a time.</p></div><span class="count" id="skill-count">{skills.length} Skills</span></div>
    <div class="search-line"><label class="search-input"><span aria-hidden="true">⌕</span><input id="skill-search" type="search" placeholder="Search skills by name, purpose, or tags..." autocomplete="off"/><kbd>/</kbd></label></div>
    <div class="filters" role="group" aria-label="Skill category">
      <button class="filter active" data-filter="all" aria-pressed="true">All</button>
      {categories.map(([id, name]) => <button class="filter" data-filter={id} aria-pressed="false">{name}</button>)}
    </div>
    <div class="skills-grid" id="skills-grid">{skills.map(skill => <SkillCard skill={skill} />)}</div>
    <div class="empty-results" id="empty-results" hidden><p>No Skills match that search.</p><button class="button secondary" id="clear-search">Clear search</button></div>
  </section>
  <script>
    const field = document.querySelector<HTMLInputElement>('#skill-search');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-skill-card]'));
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const counter = document.querySelector<HTMLElement>('#skill-count');
    const empty = document.querySelector<HTMLElement>('#empty-results');
    let category = 'all';
    const filter = () => {
      const query = (field?.value ?? '').trim().toLocaleLowerCase();
      let matches = 0;
      cards.forEach(card => {
        const visible = (category === 'all' || card.dataset.category === category) && (card.dataset.search ?? '').includes(query);
        card.hidden = !visible; if (visible) matches++;
      });
      if (counter) counter.textContent = `${matches} ${matches === 1 ? 'Skill' : 'Skills'}`;
      if (empty) empty.hidden = matches !== 0;
    };
    field?.addEventListener('input', filter);
    tabs.forEach(tab => tab.addEventListener('click', () => {
      category = tab.dataset.filter ?? 'all';
      tabs.forEach(t => { t.classList.toggle('active', t === tab); t.setAttribute('aria-pressed', String(t === tab)); });
      filter();
    }));
    document.querySelector('#clear-search')?.addEventListener('click', () => {if (field) field.value = ''; category='all'; tabs[0]?.click(); field?.focus(); filter();});
    document.addEventListener('keydown', event => {
      if (event.key === '/' && !(event.target instanceof HTMLInputElement) && !(event.target instanceof HTMLTextAreaElement) && !event.altKey && !event.ctrlKey && !event.metaKey) {
        event.preventDefault(); field?.focus();
      }
    });
    if (location.hash === '#explore' && field) field.focus({preventScroll:true});
  </script>
</Base>
