---
import Base from '../layouts/Base.astro';
import { skills, installCommand } from '../lib/catalog';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Unravel Skills — Skills for AI Agents">
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="eyebrow"><span class="eyebrow-dot"></span> OPEN SOURCE AGENT SKILLS</span>
      <h1>Skills for <span class="gradient-text">AI Agents.</span></h1>
      <p class="hero-lead">Discover, understand and install reusable Agent Skills. Designed for builders, thinkers and curious minds.</p>
      <div class="install-box">
        <div class="install-label"><span>⌘</span> Quick install <span class="install-note">Candidate · verify before use</span></div>
        <div class="command-line"><code>{installCommand}</code><button class="copy-button" data-copy={installCommand} aria-label="Copy installation command">Copy</button></div>
      </div>
      <div class="hero-actions"><a class="button primary" href="#explore">Explore Skills ↓</a><a class="button secondary" href={`${base}/docs/`}>View Docs ↗</a></div>
    </div>
  </section>
  <section class="collection-hub container" id="explore" aria-labelledby="collections-title">
    <div class="section-head">
      <div>
        <span class="eyebrow small">THE COLLECTION</span>
        <h2 id="collections-title">Explore Skills<span class="accent-dot">.</span></h2>
        <p>Choose between Skills built here and carefully selected work from others.</p>
      </div>
    </div>
    <div class="collection-options">
      <a class="collection-option" href={`${base}/skills/`}>
        <span class="collection-option-icon" aria-hidden="true">◇</span>
        <span class="eyebrow small">MADE BY UNRAVEL</span>
        <h3>Unravel Skills</h3>
        <p>Skills designed and maintained by the Unravel Skills project, with documentation and installation guidance.</p>
        <span class="collection-option-footer"><strong>{skills.length} Skills</strong><span>Browse Unravel Skills <span aria-hidden="true">→</span></span></span>
      </a>
      <a class="collection-option collection-option-curated" href={`${base}/curated/`}>
        <span class="collection-option-icon" aria-hidden="true">↗</span>
        <span class="eyebrow small">EXTERNAL PICKS</span>
        <h3>Curated Skills</h3>
        <p>Useful Skills created elsewhere, reviewed by us and linked to their original projects.</p>
        <span class="collection-option-footer"><strong>Independent projects</strong><span>Explore curated Skills <span aria-hidden="true">→</span></span></span>
      </a>
    </div>
  </section>
</Base>
