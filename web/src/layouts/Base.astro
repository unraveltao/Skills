---
import '../styles/global.css';
const { title = 'Unravel Skills', description = 'Discover, understand and install reusable Agent Skills.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-theme="light" data-accent="blue">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#0b1020"/>
    <link rel="icon" type="image/svg+xml" href={`${base}/brand-mark.svg?v=2`}/>
    <title>{title}</title>
    <script is:inline>
      try {
        const mode = localStorage.getItem('unravel-mode');
        const accent = localStorage.getItem('unravel-accent');
        document.documentElement.dataset.theme = mode === 'dark' ? 'dark' : 'light';
        if (['blue','teal','green','orange','rose','indigo'].includes(accent)) document.documentElement.dataset.accent = accent;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="navbar">
      <div class="container nav-inner">
        <a class="brand" href={`${base}/`} aria-label="Unravel Skills home">
          <span class="brand-mark" aria-hidden="true"><img src={`${base}/brand-mark.svg`} width="25" height="25" alt="" decoding="async" /></span><span>Unravel <strong>Skills</strong></span>
        </a>
        <nav class="desktop-nav" aria-label="Primary">
          <a class:list={[{ active: current === `${base}/` || current.startsWith(`${base}/skills/`) }]} href={`${base}/#explore`}>Skills</a>
          <a class:list={[{ active: current.startsWith(`${base}/docs/`) }]} href={`${base}/docs/`}>Docs</a>
          <a class:list={[{ active: current.startsWith(`${base}/blog/`) }]} href={`${base}/blog/`}>Blog</a>
        </nav>
        <div class="nav-actions">
          <a class="icon-button" href={`${base}/#explore`} aria-label="Search Skills" title="Search Skills"><span aria-hidden="true">⌕</span></a>
          <button class="icon-button" id="theme-toggle" aria-label="Switch to dark theme" title="Switch to dark theme"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.768 3.96v.001l-.002-.005a9.08 9.08 0 0 0-.218-.779c-.13-.394.21-.8.602-.67.29.096.575.205.855.328l.01.005A10.002 10.002 0 0 1 12 22a10.002 10.002 0 0 1-9.162-5.985l-.004-.01a9.722 9.722 0 0 1-.329-.855c-.13-.392.277-.732.67-.602.257.084.517.157.78.218l.004.002A9 9 0 0 0 14.999 6a9.09 9.09 0 0 0-.231-2.04ZM16.5 6c0 5.799-4.701 10.5-10.5 10.5-.426 0-.847-.026-1.26-.075A8.5 8.5 0 1 0 16.425 4.74c.05.413.075.833.075 1.259Z"/></svg></button>
<a class="icon-button desktop-github" href="https://github.com/unraveltao/Skills" rel="noopener noreferrer" target="_blank" aria-label="GitHub repository" title="GitHub"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188 .5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943"/></svg></a>
          <button class="icon-button mobile-menu-button" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle navigation">☰</button>
        </div>
      </div>
      <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" hidden>
        <a href={`${base}/#explore`}>Skills</a>
        <a href={`${base}/docs/`}>Docs</a>
        <a href={`${base}/blog/`}>Blog</a>
        <a href="https://github.com/unraveltao/Skills" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer"><div class="container footer-inner"><span>Unravel Skills · Built for curious agents.</span><a href="https://github.com/unraveltao/Skills">View on GitHub ↗</a></div></footer>
    <div class="theme-dock" aria-label="Accent color picker">
      <span class="theme-dock-label">Accent</span>
      {['blue','teal','green','orange','rose','indigo'].map(color => <button type="button" class={`swatch swatch-${color}`} data-set-accent={color} aria-label={`Use ${color} accent`} title={color}></button>)}
    </div>
    <script>
      const html = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const moonIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.768 3.96v.001l-.002-.005a9.08 9.08 0 0 0-.218-.779c-.13-.394.21-.8.602-.67.29.096.575.205.855.328l.01.005A10.002 10.002 0 0 1 12 22a10.002 10.002 0 0 1-9.162-5.985l-.004-.01a9.722 9.722 0 0 1-.329-.855c-.13-.392.277-.732.67-.602.257.084.517.157.78.218l.004.002A9 9 0 0 0 14.999 6a9.09 9.09 0 0 0-.231-2.04ZM16.5 6c0 5.799-4.701 10.5-10.5 10.5-.426 0-.847-.026-1.26-.075A8.5 8.5 0 1 0 16.425 4.74c.05.413.075.833.075 1.259Z"/></svg>';
      const sunIcon = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19a7 7 0 1 1 0-14 7 7 0 0 1 0 14Zm0-1.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 1 0 0 11Zm-5.657.157a.75.75 0 0 1 0 1.06l-1.768 1.768a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734l1.767-1.768a.75.75 0 0 1 1.061 0ZM3.515 3.515a.75.75 0 0 1 1.06 0l1.768 1.768a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L3.515 4.575a.75.75 0 0 1 0-1.06ZM12 0a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 12 0ZM4 12a.75.75 0 0 1-.75.75H.75a.75.75 0 0 1 0-1.5h2.5A.75.75 0 0 1 4 12Zm8 8a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-1.5 0v-2.5A.75.75 0 0 1 12 20Zm12-8a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h2.5A.75.75 0 0 1 24 12Zm-6.343 5.657a.75.75 0 0 1 1.06 0l1.768 1.768a.751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018l-1.768-1.767a.75.75 0 0 1 0-1.061Zm2.828-14.142a.75.75 0 0 1 0 1.06l-1.768 1.768a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042l1.767-1.768a.75.75 0 0 1 1.061 0Z"/></svg>';
      const syncTheme = () => {
        if (!toggle) return;
        const isLight = html.dataset.theme === 'light';
        toggle.innerHTML = isLight ? moonIcon : sunIcon;
        const target = isLight ? 'dark' : 'light';
        toggle.setAttribute('aria-label', `Switch to ${target} theme`);
        toggle.title = `Switch to ${target} theme`;
      };
      syncTheme();
      toggle?.addEventListener('click', () => {
        html.dataset.theme = html.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('unravel-mode', html.dataset.theme); } catch {}
        syncTheme();
      });
      document.querySelectorAll<HTMLButtonElement>('[data-set-accent]').forEach(button => {
        button.addEventListener('click', () => {
          html.dataset.accent = button.dataset.setAccent;
          try { localStorage.setItem('unravel-accent', html.dataset.accent ?? 'blue'); } catch {}
          syncAccent();
        });
      });
      const syncAccent = () => document.querySelectorAll<HTMLButtonElement>('[data-set-accent]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.setAccent === html.dataset.accent)));
      syncAccent();
      const menuButton = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-menu');
      menuButton?.addEventListener('click', () => {
        const open = menu?.hasAttribute('hidden');
        if (!menu) return;
        menu.toggleAttribute('hidden', !open);
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.textContent = open ? '×' : '☰';
      });
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => button.addEventListener('click', async () => {
        const value = button.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(value);
          const previous = button.textContent ?? 'Copy';
          button.textContent = 'Copied!';
          window.setTimeout(() => {button.textContent = previous;}, 1500);
        } catch { button.textContent = 'Select the command to copy'; }
      }));
    </script>
  </body>
</html>
